# Copy this file to .env and adjust the values. Never commit .env.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartdesk
POSTGRES_PORT=5433

# --- Application ---
# Must match the PostgreSQL values above.
DATABASE_URL=postgresql://smartdesk:change-me@localhost:5433/smartdesk?schema=public

# --- Auth.js ---
# Secret used to sign and encrypt session tokens (min. 32 characters).
# Required: the app refuses to start while it is empty.
# Generate one with: npx auth secret   (or any 32+ byte random value)
AUTH_SECRET=
# Required in production behind a proxy/custom domain, e.g. https://app.example.com
# AUTH_URL=

# --- Development seed ---
# Password given to every user created by `npm run db:seed` (min. 12 characters).
# Required by the seed; choose any value for local development.
SEED_USER_PASSWORD=

# --- SmartAI (/smartai) ---
# Anthropic API key for SmartAI Studio. Leave empty to run SmartAI in demo mode
# (template answers, no AI calls). Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: Claude model used by SmartAI (default: claude-opus-5-5).
# SMARTAI_MODEL=

# --- Website publishing (Netlify, see netlify.toml) ---
# Public address of the site. Netlify sets URL by itself; set this when you use your own domain.
# SITE_URL=https://smarthub.example
# Search engines may index the site only with "on" (default: closed, noindex everywhere).
# SITE_INDEXING=on
# "1" publishes only the public pages (no database): accounts and SmartDesk redirect to /contacto.
# SHOWCASE_MODE=1
# Google Search Console verification code (HTML tag method), when you add the site.
# GOOGLE_SITE_VERIFICATION=
