# Copy this file to .env and adjust the values. Never commit .env.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartdesk
POSTGRES_PORT=5433

# --- Application ---
# Must match the PostgreSQL values above.
DATABASE_URL=postgresql://smartdesk:change-me@localhost:5433/smartdesk?schema=public

# --- Auth.js ---
# Secret used to sign and encrypt session tokens (min. 32 characters).
# Required: the app refuses to start while it is empty.
# Generate one with: npx auth secret   (or any 32+ byte random value)
AUTH_SECRET=
# Required in production behind a proxy/custom domain, e.g. https://app.example.com
# AUTH_URL=

# --- Development seed ---
# Password given to every user created by `npm run db:seed` (min. 12 characters).
# Required by the seed; choose any value for local development.
SEED_USER_PASSWORD=
