# Copy this file to .env.local for local development and fill in what you need.
# In Netlify, add the same variables under Site configuration > Environment variables.
# Never commit real values.

# --- Website ---
# Public address of the site (Netlify sets URL by itself; set this when you use your own domain).
# SITE_URL=https://advanthor.example
# Search engines may index the site only with "on" (default: closed, noindex everywhere).
# SITE_INDEXING=on
# Google Search Console verification code (HTML tag method).
# GOOGLE_SITE_VERIFICATION=

# --- Contact form (email through Resend, https://resend.com) ---
# Without these three the form says email is not available yet and offers WhatsApp.
# RESEND_API_KEY=
# Inbox that receives the requests.
# CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend (SPF/DKIM records added to the DNS).
# CONTACT_FROM_EMAIL="Advanthor <web@advanthor.example>"
# Public contact email shown on the site (optional).
# NEXT_PUBLIC_CONTACT_EMAIL=

# --- Anti-spam (Cloudflare Turnstile, optional; honeypot, time check and rate limit always work) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Meetings (optional): public booking link (Cal.com, Calendly, Google Calendar...) ---
# NEXT_PUBLIC_BOOKING_URL=

# --- Analytics (optional): Google Analytics 4, loaded only after the visitor accepts analytics cookies ---
# NEXT_PUBLIC_GA_ID=
