generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Tenant root. Every business record belongs to exactly one organization.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  clients     Client[]
  projects    Project[]

  @@map("organizations")
}

/// Global identity. Access to tenant data is granted only through Membership.
/// Field names follow the Auth.js adapter conventions.
model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships     Membership[]
  createdProjects Project[]    @relation("ProjectCreatedBy")

  @@map("users")
}

/// Links a user to an organization with a role.
model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           Role     @default(EMPLOYEE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Client {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  company        String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([organizationId, email])
  /// Target of the composite foreign key from Project (same-tenant guarantee).
  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@map("clients")
}

/// A piece of work for one client. Prepared to own tasks, events, documents,
/// team members and activity in later phases.
model Project {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  clientId       String          @map("client_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus   @default(PLANNING)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?       @map("start_date") @db.Date
  dueDate        DateTime?       @map("due_date") @db.Date
  budget         Decimal?        @db.Decimal(12, 2)
  estimatedHours Decimal?        @map("estimated_hours") @db.Decimal(8, 2)
  /// Null only if the creating user is deleted later.
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: the database itself rejects a client from another organization.
  /// NoAction: a client with projects cannot be deleted by accident, while
  /// deleting a whole organization still cascades (checked at statement end).
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([createdById])
  @@map("projects")
}
