generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CalendarEventType {
  MEETING
  REMINDER
  DELIVERY
  INTERNAL
  OTHER
}

/// Tenant root. Every business record belongs to exactly one organization.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  clients        Client[]
  projects       Project[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@map("organizations")
}

/// Global identity. Access to tenant data is granted only through Membership.
/// Field names follow the Auth.js adapter conventions.
model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships     Membership[]
  createdProjects Project[]       @relation("ProjectCreatedBy")
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreatedBy")
  createdEvents   CalendarEvent[] @relation("CalendarEventCreatedBy")

  @@map("users")
}

/// Links a user to an organization with a role.
model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           Role     @default(EMPLOYEE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Tasks assigned to this member (same-tenant guarantee for Task.assignee).
  assignedTasks  Task[]
  /// Events assigned to this member (same-tenant guarantee for CalendarEvent.assignedTo).
  assignedEvents CalendarEvent[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Client {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  company        String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  calendarEvents CalendarEvent[]

  @@unique([organizationId, email])
  /// Target of the composite foreign key from Project (same-tenant guarantee).
  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@map("clients")
}

/// A piece of work for one client. Prepared to own tasks, events, documents,
/// team members and activity in later phases.
model Project {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  clientId       String          @map("client_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus   @default(PLANNING)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?       @map("start_date") @db.Date
  dueDate        DateTime?       @map("due_date") @db.Date
  budget         Decimal?        @db.Decimal(12, 2)
  estimatedHours Decimal?        @map("estimated_hours") @db.Decimal(8, 2)
  /// Null only if the creating user is deleted later.
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: the database itself rejects a client from another organization.
  /// NoAction: a client with projects cannot be deleted by accident, while
  /// deleting a whole organization still cascades (checked at statement end).
  client         Client          @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  createdBy      User?           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks          Task[]
  calendarEvents CalendarEvent[]

  /// Target of the composite foreign keys from Task and CalendarEvent (same-tenant guarantee).
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([createdById])
  @@map("projects")
}

/// A unit of work inside a project, assigned to one member of the organization.
/// Prepared for comments, subtasks, attachments, time tracking and activity later.
model Task {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String       @map("assignee_id") @db.Uuid
  /// Null only if the creating user is deleted later.
  createdById    String?      @map("created_by_id") @db.Uuid
  /// Calendar dates (no time), stored as UTC midnight.
  startDate      DateTime?    @map("start_date") @db.Date
  dueDate        DateTime?    @map("due_date") @db.Date
  /// Set by the service when the task becomes COMPLETED, cleared otherwise.
  completedAt    DateTime?    @map("completed_at")
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(8, 2)
  actualHours    Decimal?     @map("actual_hours") @db.Decimal(8, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite key: the database rejects a project from another organization.
  /// Deleting a project deletes its tasks.
  project            Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee           User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction)
  /// Composite key to the membership: the assignee must be a member of the task's
  /// organization. NoAction: a member with tasks cannot be removed until the tasks
  /// are reassigned (deleting the whole organization still cascades).
  assigneeMembership Membership      @relation(fields: [assigneeId, organizationId], references: [userId, organizationId], onDelete: NoAction)
  createdBy          User?           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  calendarEvents     CalendarEvent[]

  /// Target of the composite foreign key from CalendarEvent (same-tenant guarantee).
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, status, dueDate])
  @@index([createdById])
  @@map("tasks")
}

/// Something scheduled at a date and time (meeting, reminder, delivery...).
/// Tasks are NOT copied here: the calendar reads them from Task and combines
/// both in memory. Prepared for recurrence, attendees and sync in later phases.
model CalendarEvent {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  title          String
  description    String?
  type           CalendarEventType @default(MEETING)
  /// Instants (UTC). An all-day event goes from local midnight (Europe/Madrid)
  /// of its first day to local midnight of the day after its last day.
  startDateTime  DateTime          @map("start_date_time")
  endDateTime    DateTime          @map("end_date_time")
  allDay         Boolean           @default(false) @map("all_day")
  location       String?
  /// Null only if the creating user is deleted later.
  createdById    String?           @map("created_by_id") @db.Uuid
  assignedToId   String?           @map("assigned_to_id") @db.Uuid
  clientId       String?           @map("client_id") @db.Uuid
  projectId      String?           @map("project_id") @db.Uuid
  taskId         String?           @map("task_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Composite keys: the database rejects an assignee, client, project or task
  /// from another organization (a null id skips the check). NoAction: the
  /// repositories unlink events before deleting a client, project or task, and
  /// deleting a whole organization still cascades (checked at statement end).
  assignedTo   Membership?  @relation(fields: [assignedToId, organizationId], references: [userId, organizationId], onDelete: NoAction)
  client       Client?      @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  project      Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: NoAction)
  task         Task?        @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: NoAction)

  /// Visible-range queries: events overlapping a period inside one organization.
  @@index([organizationId, startDateTime])
  @@index([organizationId, assignedToId, startDateTime])
  @@index([organizationId, projectId])
  @@index([organizationId, clientId])
  @@index([organizationId, taskId])
  @@index([createdById])
  @@map("calendar_events")
}
